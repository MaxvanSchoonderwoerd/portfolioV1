---
const { title, subtitle, description, highlight = false } = Astro.props;

// Split the description into paragraphs on blank lines so translators can
// insert breaks with `\n\n` in the plain-text i18n strings.
const paragraphs =
  typeof description === "string"
    ? description
        .split(/\n\s*\n/)
        .map((p) => p.trim())
        .filter(Boolean)
    : [];
---

<div class={`flex`}>
  <div class="education__time w-6 shrink-0 flex flex-col items-center">
    <span
      class={`block rounded-full shrink-0 ${
        highlight
          ? "w-6 h-6 bg-primary ring-4 ring-primary/30"
          : "w-4 h-4 bg-primary"
      }`}></span>
    <span class="bg-primary education__line block h-full w-[2px]"></span>
  </div>
  <div class="experience__data bd-grid px-5 mb-8">
    <h3 class={`mb-1 font-bold ${highlight ? "text-xl" : "text-lg"}`}>
      {title}
    </h3>
    <span class="font-light text-sm italic">{subtitle}</span>
    {
      paragraphs.map((paragraph) => (
        <p class="my-2 text-justify">{paragraph}</p>
      ))
    }
  </div>
</div>
